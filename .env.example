# Copia a .env y rellena con los valores del proyecto Supabase tem-redes
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Webhook n8n que genera propuestas con Claude
VITE_N8N_GENERAR_URL=https://TU-N8N/webhook/tem-redes/generar-propuestas

# Webhook n8n del copiloto (ajusta una pieza con Claude)
VITE_N8N_AJUSTAR_URL=https://TU-N8N/webhook/tem-redes/ajustar-pieza
